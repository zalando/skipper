// Custom route kube_rg__ns__issue2268__all__0_1 has the same number of predicates as the kube_rg__ns__issue2268__all__1_0 route
// which causes undefined behavior: a request with foo cookie might be routed to any of them.
kube_rg__ns__issue2268__all__0_0: HostAny("test.example.org", "test.example.org.") && PathSubtree("/") && Cookie("foo", "^") && Traffic(0.6) -> "http://42.0.0.1:8080";
kube_rg__ns__issue2268__all__0_1: HostAny("test.example.org", "test.example.org.") && PathSubtree("/") && Cookie("foo", "^")                 -> "http://42.0.0.2:8080";
kube_rg__ns__issue2268__all__1_0: HostAny("test.example.org", "test.example.org.") && PathSubtree("/") && Traffic(0.8)                       -> "http://42.0.0.3:8080";
kube_rg__ns__issue2268__all__1_1: HostAny("test.example.org", "test.example.org.") && PathSubtree("/")                                       -> "http://42.0.0.4:8080";

kube_rg____test_example_org__catchall__0_0: HostAny("test.example.org", "test.example.org.") -> <shunt>;
