kube_rg____example_org__catchall__0_0: HostAny("example.org", "example.org.") -> <shunt>;
kube_rg__default__myapp__all__0_0: HostAny("example.org", "example.org.") && Path("/app") && TrafficSegment(0, 0.6) -> <roundRobin, "http://10.2.4.16:80", "http://10.2.4.8:80">;
kube_rg__default__myapp__all__0_1: HostAny("example.org", "example.org.") && Path("/app") && TrafficSegment(0.6, 0.9) -> "https://www.example.org";
