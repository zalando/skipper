kube_foo__qux__0__www1_example_org_____:
  HostAny("www1.example.org", "www1.example.org.") &&
  PathRegexp("^/") &&
  Method("OPTIONS") -> <shunt>;

kube_foo__qux__www1_example_org_____bar:
  HostAny("www1.example.org", "www1.example.org.") &&
  PathRegexp("^/")
  -> <roundRobin, "http://10.2.9.103:8080", "http://10.2.9.104:8080">;

