kube_foo__qux__www_example_org_____qux:
	HostAny("www.example.org", "www.example.org.") && PathRegexp("^/")
	-> consecutiveBreaker(15)
	-> <roundRobin, "http://10.2.9.103:8080", "http://10.2.9.104:8080">;
kubeew_foo__qux__www_example_org_____qux:
	HostAny("qux.foo.skipper.cluster.local", "qux.foo.skipper.cluster.local.") && PathRegexp("^/")
	-> consecutiveBreaker(15)
	-> <roundRobin, "http://10.2.9.103:8080", "http://10.2.9.104:8080">;
