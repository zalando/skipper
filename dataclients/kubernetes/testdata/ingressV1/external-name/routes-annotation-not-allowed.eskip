kube_default__myapp__example_org____external1_example_org:
	HostAny("example.org", "example.org.")
	-> setRequestHeader("Host", "external1.example.org")
	-> "https://external1.example.org:443";

kube_default__myapp_allowed_0__example_org_one____:
	HostAny("example.org", "example.org.")
	&& Header("X-Route", "allowed")
	&& PathRegexp("^(/one)")
	-> "https://external1.example.org";

kube_default__myapp_shunt_3__example_org_one____:
	HostAny("example.org", "example.org.")
	&& Header("X-Route", "shunt")
	&& PathRegexp("^(/one)")
	-> status(204)
	-> <shunt>;
